---
import BaseLayout from './BaseLayout.astro';
export interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  headline?: string;   // large H1 in hero, defaults to title
  intro?: string;      // subtitle under H1
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: string;
  modifiedAt?: string;
  author?: string;
  lang?: 'pt-PT' | 'en-GB';
  alternates?: { lang: string; href: string }[];
}
const { eyebrow, headline, intro, ...seo } = Astro.props;
const h1 = headline ?? seo.title.replace(/, .*$/, '');
---
<BaseLayout {...seo}>
  <div class="max-w-3xl mx-auto px-6">
    <header class="pt-8 pb-14 md:pt-16 md:pb-20">
      {eyebrow && (
        <p class="text-sm font-semibold tracking-widest text-[var(--color-accent)] uppercase">{eyebrow}</p>
      )}
      <h1 class="mt-3 text-4xl md:text-6xl font-bold tracking-[-0.03em] leading-[1.05] text-[var(--color-ink)]">
        {h1}
      </h1>
      {intro && (
        <p class="mt-5 text-lg md:text-xl text-[var(--color-ink-soft)] leading-relaxed">{intro}</p>
      )}
    </header>
    <article class="prose">
      <slot />
    </article>
  </div>
</BaseLayout>
