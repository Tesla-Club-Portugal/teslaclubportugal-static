---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: string;
  modifiedAt?: string;
  author?: string;
  lang?: 'pt-PT' | 'en-GB';
  alternates?: { lang: string; href: string }[];
  fullBleed?: boolean;   // for hero-first pages (no top padding on main)
}
const { fullBleed = false, ...seo } = Astro.props;
const htmlLang = seo.lang ?? 'pt-PT';
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <SEO {...seo} />
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar para o conteúdo</a>
    <Nav />
    <main id="main" class={fullBleed ? '' : 'pt-24 pb-20'}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
