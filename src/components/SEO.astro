---
export interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishedAt?: string;
  modifiedAt?: string;
  author?: string;
  lang?: 'pt-PT' | 'en-GB';
  alternates?: { lang: string; href: string }[];
}

const {
  title,
  description,
  image = '/images/og-default.jpg',
  canonical,
  type = 'website',
  publishedAt,
  modifiedAt,
  author,
  lang = 'pt-PT',
  alternates = [],
} = Astro.props;

const site = Astro.site!.toString().replace(/\/$/, '');
const url = new URL(Astro.url.pathname, site).toString();
const canonicalUrl = canonical ?? url;
const imageUrl = image.startsWith('http') ? image : `${site}${image}`;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Tesla Club Portugal',
  alternateName: 'TCP',
  url: site,
  logo: `${site}/images/logo.svg`,
  sameAs: ['https://www.facebook.com/groups/teslaclubportugal'],
  description: 'Clube oficial em português de fãs Tesla — Model S, 3, X, Y, Cybertruck. Guias, superchargers, parcerias, comunidade.',
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Tesla Club Portugal',
  url: site,
  inLanguage: lang,
};

const articleLd = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: imageUrl,
  url: canonicalUrl,
  ...(publishedAt && { datePublished: publishedAt }),
  ...(modifiedAt && { dateModified: modifiedAt }),
  ...(author && { author: { '@type': 'Person', name: author } }),
  publisher: {
    '@type': 'Organization',
    name: 'Tesla Club Portugal',
    logo: { '@type': 'ImageObject', url: `${site}/images/logo.svg` },
  },
  inLanguage: lang,
} : null;
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<meta name="theme-color" content="#171a20" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/wp-content/uploads/2021/01/cropped-2020_TOC_Logo-Portugal_Artboard-1-3-180x180.png" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />

{alternates.map(a => (
  <link rel="alternate" hreflang={a.lang} href={new URL(a.href, site).toString()} />
))}
<link rel="alternate" hreflang="x-default" href={site} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content="Tesla Club Portugal" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={lang === 'pt-PT' ? 'pt_PT' : 'en_GB'} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
{articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
