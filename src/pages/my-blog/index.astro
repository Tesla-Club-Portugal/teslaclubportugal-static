---
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = [
  {
    href: '/2018/12/23/model-3-o-carro-que-muda-tudo/',
    title: 'Model 3 — o carro que muda tudo',
    date: '2018-12-23',
    excerpt: 'Comparação Tesla Model 3 vs BMW Série 3 vs Mercedes Classe C — custo total ao fim de 5 anos, emissões, performance. Resultados embaraçosos para os concorrentes a combustão.',
    tags: ['Model 3', 'Comparação'],
  },
  {
    href: '/2018/04/06/bem-vindos-ao-tesla-club-portugal/',
    title: 'Bem-vindos ao Tesla Club Portugal',
    date: '2018-04-06',
    excerpt: 'A publicação inaugural do clube. Informações sobre carregamento, rotas, diários de bordo e a secção em inglês para visitantes estrangeiros.',
    tags: ['Anúncios'],
  },
];
---
<BaseLayout
  title="Blog — Tesla Club Portugal"
  description="Artigos e reflexões do Tesla Club Portugal — comparações de modelos, viagens, análises técnicas escritas por membros."
>
  <header class="max-w-4xl mx-auto px-6 pt-8 pb-14 md:pt-16 md:pb-20">
    <p class="text-sm font-semibold tracking-widest text-[var(--color-accent)] uppercase">Blog</p>
    <h1 class="mt-3 text-4xl md:text-6xl font-bold tracking-[-0.03em] leading-[1.05] text-[var(--color-ink)]">
      Escrito por membros.
    </h1>
    <p class="mt-5 text-lg md:text-xl text-[var(--color-ink-soft)] leading-relaxed max-w-3xl">
      Artigos ocasionais — análises, comparações, viagens. Não há calendário editorial: publica-se quando há algo que valha a pena partilhar.
    </p>
  </header>

  <section class="max-w-3xl mx-auto px-6 pb-24 space-y-6">
    {posts.map(p => (
      <article class="rounded-2xl border border-[var(--color-line)] p-6 md:p-8 hover:border-[var(--color-ink)] transition">
        <time class="text-sm text-[var(--color-ink-muted)]" datetime={p.date}>
          {new Date(p.date).toLocaleDateString('pt-PT', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <h2 class="mt-2 text-2xl md:text-3xl font-bold tracking-tight text-[var(--color-ink)]">
          <a href={p.href} class="hover:text-[var(--color-accent)] transition">{p.title}</a>
        </h2>
        <p class="mt-3 text-[var(--color-ink-soft)] leading-relaxed">{p.excerpt}</p>
        <div class="mt-4 flex gap-2">
          {p.tags.map(t => <span class="text-xs uppercase tracking-widest font-semibold px-2 py-0.5 rounded-full bg-[var(--color-surface-alt)] text-[var(--color-ink-muted)]">{t}</span>)}
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
