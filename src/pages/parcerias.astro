---
import BaseLayout from '../layouts/BaseLayout.astro';

const partners = [
  { name: 'CarDetail',            url: null,                                                         logo: null, perk: '10% de desconto num catálogo completo de películas e produtos de detalhe automóvel.' },
  { name: 'WattsOnWheels',        url: null,                                                         logo: null, perk: '10% em alugueres, usa o código TESLACLUBPORTUGAL no checkout. 1% em compra de viaturas, menciona o TCP no acto.' },
  { name: 'SóPeliculas',          url: null,                                                         logo: null, perk: '10% de desconto em películas.' },
  { name: 'uCharge',              url: null,                                                         logo: null, perk: '10% em instalações eléctricas, produtos, e centro de assistência técnica. Não acumula com promoções.' },
  { name: 'Tesla Portugal Tours', url: null,                                                         logo: null, perk: '10% em todos os serviços.' },
  { name: 'VPelículas Bobadela',  url: 'https://www.facebook.com/VPeliculasBobadela/',               logo: null, perk: '10% em todos os serviços, excepto legalizações.' },
  { name: 'Portugal EV Tours',    url: 'https://portugalevtours.com',                                logo: null, perk: '10% em todos os serviços. Usa o código PEVTTCP na reserva.' },
  { name: 'Details Concept',      url: 'https://www.facebook.com/DetailsConcept/',                   logo: '/wp-content/uploads/2020/07/108398290_325330375150262_4462186185038129178_n-300x171.jpg', perk: '10% em todos os serviços.' },
  { name: 'Detail Imperial',      url: 'https://www.facebook.com/detailimperial01/',                 logo: '/wp-content/uploads/2020/08/image-300x271.png', perk: 'Vários descontos em todos os serviços.' },
  { name: 'Fama Car Care',        url: 'https://www.facebook.com/FamaCarCare',                       logo: '/wp-content/uploads/2020/10/Screenshot-2020-10-04-at-12.51.27.png', perk: 'Vários descontos em serviços de detalhe.' },
  { name: 'Caldas Detail Garage', url: 'https://www.facebook.com/Caldas-Detail-Garage-Detalhe-Autom%C3%B3vel-2437249386302286', logo: '/wp-content/uploads/2021/10/136973713_4478769702150234_9187726089871193951_n-2.jpg', perk: '10% em películas, PPF, detalhe e car wrapping.' },
  { name: 'NC Wrapping',          url: 'https://www.facebook.com/ncwrapping',                        logo: '/wp-content/uploads/2022/04/273622381_462124965402064_420797304699901736_n.jpg', perk: 'Oferta da aplicação de proteção cerâmica (valor de 150€) e do serviço de limpeza na compra de um wrapping. 10% em películas e chrome delete.' },
  { name: 'ChargeGuru',           url: 'https://chargeguru.typeform.com/to/xQvGzuBk',                logo: '/wp-content/uploads/2023/05/chargeguru_logo.png', perk: '10% no carregador e instalação em moradias. 10% em instalação em apartamentos com ligação à fração. Excepto quando o carregador é um Tesla Wall Connector, aí o desconto não se aplica ao equipamento.' },
  { name: 'Best Química',         url: 'https://bestquimica.com/',                                   logo: '/wp-content/uploads/2023/06/292264317_460126686114964_5028808671759906943_n.png', perk: '10% em todos os produtos na loja online, código Tesla.' },
  { name: 'Moticristo Mafra',     url: 'https://moticristo.pt/oficina-auto/',                        logo: '/wp-content/uploads/2024/07/Logo_Novo_Preto.png', perk: '10% em todos os serviços, incluindo rent-a-car. Peças excluídas. É Tesla Approved Body Shop.' },
  { name: 'Ampère',               url: 'http://www.ampere.pt/',                                      logo: '/wp-content/uploads/2024/09/logo.png', perk: 'Orçamento grátis por videochamada. 10% em mão de obra. Oferta de miniatura Tesla (Hot Wheels ou Matchbox) do carro que tens. Viana do Castelo, Braga, Vila Real e Porto.' },
  { name: 'RVTec',                url: 'https://rvtec.pt/',                                          logo: '/wp-content/uploads/2026/04/logotransparente-1.png', perk: '10% sobre o orçamento. Santarém e Lisboa. Válido até fim de 2026.' },
];
---
<BaseLayout
  title="Parcerias e descontos para membros | Tesla Club Portugal"
  description="Descontos negociados para membros do Tesla Club Portugal: películas, detalhe automóvel, wall boxes, carregadores, oficinas. Basta apresentar o cartão de membro."
>
  <section class="bg-[var(--color-surface-alt)] border-b border-[var(--color-line)]">
    <div class="max-w-6xl mx-auto px-6 pt-28 pb-10 md:pt-36 md:pb-20">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold tracking-widest text-[var(--color-accent)] uppercase">Comunidade</p>
        <h1 class="mt-3 text-4xl md:text-6xl font-bold tracking-[-0.03em] leading-[1.05] text-[var(--color-ink)]">
          Parcerias.
        </h1>
        <p class="mt-5 text-lg md:text-xl text-[var(--color-ink-soft)] leading-relaxed">
          Os membros do clube têm acesso a descontos nas empresas parceiras. Basta apresentar o cartão de membro no acto.
        </p>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 pt-10 md:pt-16 pb-24">
    <ul class="grid gap-4 md:grid-cols-2">
      {partners.map(p => (
        <li class="rounded-2xl border border-[var(--color-line)] p-5 md:p-6 hover:border-[var(--color-ink)] transition flex gap-5 items-start">
          <div class="flex-shrink-0 w-20 h-20 md:w-24 md:h-24 rounded-xl bg-[var(--color-surface-alt)] overflow-hidden flex items-center justify-center">
            {p.logo ? (
              <img src={p.logo} alt={`Logo ${p.name}`} loading="lazy" decoding="async" class="w-full h-full object-contain p-2" />
            ) : (
              <img src="/images/logo-tcp-96.png" alt="" aria-hidden="true" loading="lazy" decoding="async" class="w-10 h-10 md:w-12 md:h-12 opacity-30" />
            )}
          </div>
          <div class="flex-1 min-w-0">
            <h2 class="text-lg font-semibold text-[var(--color-ink)]">
              {p.url ? <a href={p.url} target="_blank" rel="noopener" class="hover:text-[var(--color-accent)]">{p.name} <span aria-hidden="true" class="text-[var(--color-ink-muted)] font-normal">↗</span></a> : p.name}
            </h2>
            <p class="mt-2 text-[var(--color-ink-soft)] leading-relaxed text-[15px]">{p.perk}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-16 rounded-2xl bg-[var(--color-surface-alt)] p-8 text-center">
      <h2 class="text-2xl font-semibold text-[var(--color-ink)]">Empresa a querer ser parceira?</h2>
      <p class="mt-3 text-[var(--color-ink-soft)] max-w-2xl mx-auto">
        Manda uma mensagem no <a href="https://www.facebook.com/groups/teslaclubportugal" target="_blank" rel="noopener" class="text-[var(--color-accent)] underline underline-offset-4">grupo do Facebook</a>. Indica o contacto e a proposta que temos gosto em conversar.
      </p>
    </div>
  </section>
</BaseLayout>
