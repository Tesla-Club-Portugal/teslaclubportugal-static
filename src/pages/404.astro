---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Página não encontrada — Tesla Club Portugal"
  description="A página que procuras não existe. Volta ao início ou explora as secções principais."
>
  <section class="min-h-[60vh] flex flex-col items-center justify-center text-center px-6">
    <p class="text-sm font-semibold tracking-widest text-[var(--color-accent)] uppercase">404</p>
    <h1 class="mt-3 text-5xl md:text-7xl font-bold tracking-[-0.03em] text-[var(--color-ink)]">
      Página não encontrada.
    </h1>
    <p class="mt-6 text-lg text-[var(--color-ink-soft)] max-w-lg">
      O link pode estar antigo, ou esta secção já não existe. Segue para a homepage ou vê o mapa do site.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row gap-3">
      <a href="/" class="btn" style="background:var(--color-ink);color:white;">Voltar ao início</a>
      <a href="/faq/" class="btn" style="background:var(--color-surface-alt);color:var(--color-ink);">Ver FAQ</a>
    </div>
  </section>
</BaseLayout>
